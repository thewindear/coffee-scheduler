# Service Mode
APP_ENV=dev
HOST=0.0.0.0
PORT=8000
EMBEDDED_SCHEDULER=true

# Redis (Hot Path)
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=cs
DELAY_SHARD_COUNT=16

# MySQL (Persistent Store)
MYSQL_DSN=mysql+asyncmy://root:your_password@127.0.0.1:3306/coffee_scheduler
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20

# Scheduler & Flusher Tuning
PUMP_INTERVAL_MS=50
PUMP_BATCH_SIZE=200
LEASE_REAP_INTERVAL_MS=500
CRON_SCAN_INTERVAL_MS=1000
FLUSHER_BATCH_SIZE=500
FLUSHER_FLUSH_INTERVAL_MS=100
MAX_RECEIPT_BYTES=16384
